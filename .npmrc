# pnpm settings for this repo, matching the Open App workspace guidance.
#
# package-manager-strict: allows pnpm to run in a tree whose packageManager field
#   may disagree (e.g. when this repo is linked as a member of an MJ 6.x checkout
#   alongside repos that still pin npm).
# strict-peer-dependencies: peer mismatches warn instead of failing. Replaces the
#   npm-era legacy-peer-deps=true, which was here for the same reason — Angular 21
#   ships strict peer ranges that a fresh resolve rejects.
# auto-install-peers: pnpm's default; stated explicitly because turning it off
#   stops declared peers being available at build time.
#
# Any stray `npm` command will print "Unknown project config" for these lines —
# that is npm not recognising pnpm settings, not breakage.

# The @mj-biz-apps scope is published to the public npm registry. Stated explicitly
# because a developer whose personal ~/.npmrc points the scope at GitHub Packages
# (a common estate setup for @bluecypress/@askskip) otherwise gets ERR_PNPM_FETCH_404
# on a fresh install. Under npm this was masked by package-lock.json's per-package
# `resolved` URLs; with those gone the scope has to be pinned here, as bizapps-caliber
# and bizapps-ats already do.
@mj-biz-apps:registry=https://registry.npmjs.org/

package-manager-strict=false
strict-peer-dependencies=false
auto-install-peers=true
