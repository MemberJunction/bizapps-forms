# ─────────────────────────────────────────────────────────────────────────────
# MJ Forms local .env template
#
# Copy to `.env` (gitignored) and fill in the placeholders. The structural values
# below match the standard local setup created by `docs/LOCAL_SETUP.md`:
# Docker container `forms-sql` on :1456, database `MJ_Forms_Dev`, MJAPI on :4121,
# MJExplorer on :4321.
#
# Never commit real secrets — every `<...>` below is a placeholder.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (local Docker `forms-sql`) ──────────────────────────────────────
DB_HOST='localhost'
DB_PORT=1456
DB_DATABASE='MJ_Forms_Dev'
DB_TRUST_SERVER_CERTIFICATE=1          # self-signed cert in the local container
DB_USERNAME='sa'
DB_PASSWORD='<sql-sa-password>'        # SECRET — the SQL Server `sa` password
CODEGEN_DB_USERNAME='sa'
CODEGEN_DB_PASSWORD='<sql-sa-password>' # SECRET — usually same as DB_PASSWORD
MJ_CORE_SCHEMA='__mj'

# ── CodeGen / server ─────────────────────────────────────────────────────────
OUTPUT_CODE='Forms'
CONFIG_FILE='config.json'
GRAPHQL_PORT=4121
MJAPI_PUBLIC_URL='http://localhost:4121'
MJ_EXPLORER_BASE_URL='http://localhost:4321'
UPDATE_USER_CACHE_WHEN_NOT_FOUND=1
UPDATE_USER_CACHE_WHEN_NOT_FOUND_DELAY=5000

# MJ field-level encryption key. SECRET. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this after data has been encrypted makes that data unreadable.
MJ_BASE_ENCRYPTION_KEY='<base64-32-byte-key>'

# ── Authentication (Azure AD / Entra ID) ─────────────────────────────────────
# These are public identifiers, not secrets — they already ship in
# apps/MJExplorer/src/environments/environment.ts and must match it.
# MJ only registers the Azure provider when BOTH are present.
WEB_CLIENT_ID=7e6e6ecf-66ff-4733-9c60-1e6def949897
TENANT_ID=ff10ade7-5d03-40a9-be28-cb7ab99670b1

# ── Anonymous magic link (the public/anonymous submit path) ──────────────────
# Forms' whole respondent flow rides an anonymous magic-link session whose scope
# is enforced from the JWT `mj_scopes` claim. See FORMS_BUILD_PLAN §4 and
# apps/MJAPI/mj.config.cjs. Set FORMS_MAGICLINK_ENABLED=false for an install that
# does not use public forms.
FORMS_MAGICLINK_ENABLED=true

# SECRET — RS256 private key used to sign magic-link session JWTs. Accepts either a
# raw PEM (must contain `-----BEGIN`) or, easier for a single-line .env, the PEM
# base64-encoded. Generate one with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey}=generateKeyPairSync('rsa',{modulusLength:2048});console.log(Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'))"
#
# Leave it EMPTY and MJ generates an ephemeral keypair at boot — fine for local work,
# but every restart invalidates outstanding magic-link sessions. Do NOT leave a
# placeholder string here: a non-empty value that isn't a valid key crashes MJAPI at
# startup with `ERR_OSSL_UNSUPPORTED`.
MJ_MAGIC_LINK_PRIVATE_KEY=''

# ── AI provider keys (form authoring + Analyze Written Responses hook) ───────
# MJ resolves provider keys by DRIVER CLASS, not by vendor brand name. The pattern is
#   AI_VENDOR_API_KEY__<DriverClass>
# where <DriverClass> comes from `__mj.AIModelVendor.DriverClass` — e.g. GeminiLLM,
# AnthropicLLM, OpenAILLM, OpenRouterLLM, VertexLLM. A plain `OPENAI_API_KEY` is NOT read.
#
# Both Forms prompts — `Forms: Form Designer` (AI authoring) and `Forms: Response Analyzer`
# (the Analyze Written Responses on-submit hook) — are pinned in metadata to **Gemini 3.1 Pro**,
# which is served by three vendors. Set ONE of these or both prompts fail at runtime:
AI_VENDOR_API_KEY__GeminiLLM=''        # SECRET — Google direct
AI_VENDOR_API_KEY__OpenRouterLLM=''    # SECRET — same model via OpenRouter
AI_VENDOR_API_KEY__VertexLLM=''        # SECRET — same model via Vertex AI

# Other vendors, only needed if you repoint a prompt to a different model in metadata.
AI_VENDOR_API_KEY__AnthropicLLM=''     # SECRET — optional
AI_VENDOR_API_KEY__OpenAILLM=''        # SECRET — optional

# ── Anti-abuse (public write hardening) ──────────────────────────────────────
# Cloudflare Turnstile is per-DISTRIBUTION (FormDistribution.CaptchaRequired) and
# fails CLOSED: a distribution with CaptchaRequired=1 rejects every submission
# while this is unset. Leave blank only if your distributions have it off.
FORMS_TURNSTILE_SECRET=''              # SECRET — optional
# FORMS_TURNSTILE_VERIFY_URL=''        # override only to point at a test double

# How many proxies YOU operate in front of MJAPI. This is a security setting, not a
# convenience one: it is the number of trailing X-Forwarded-For entries written by
# infrastructure you control, and therefore the only ones worth reading. Leave at 0 when
# the API is addressed directly — reading a header nobody trustworthy wrote would let a
# caller pick their own rate-limit bucket, which is the bug this whole layer exists to fix.
# Set it to 1 behind a single load balancer, 2 behind a CDN in front of a load balancer.
# FORMS_TRUSTED_PROXY_HOPS=0

# Rate limits. Defaults shown; all optional.
#   MAX          per (session, distribution). The session comes from the client-settable
#                x-session-id header, so this shapes a well-behaved widget and is NOT a ceiling.
#   IP_MAX       per (client IP, distribution) — the ceiling a caller cannot rotate away from.
#   COMPLETION   per (client IP, distribution), FINAL submits only. Tighter, because a
#                completion fires the on-submit automations (email, LLM, entity upserts).
#   MAX_KEYS     buckets the in-memory store retains before evicting least-recently-charged.
# FORMS_RATELIMIT_MAX=5
# FORMS_RATELIMIT_IP_MAX=120
# FORMS_COMPLETION_MAX=20
# FORMS_RATELIMIT_MAX_KEYS=50000
# FORMS_RATELIMIT_WINDOW_MS=60000

# Uploads per rate-limit window per client IP (the public POST /forms/upload route).
# FORMS_UPLOAD_IP_MAX=30

# Salt for hashing respondent IP / session before storage — set a real value per
# environment so hashes are not comparable across deployments. Falls back to a
# hardcoded default when unset, which is fine locally and NOT fine in production.
FORMS_SESSION_HASH_SALT=''
