{
  "name": "bizapps-forms",
  "version": "0.1.0",
  "license": "BUSL-1.1",
  "description": "MJ Forms - free, open-source forms, surveys & intake for MemberJunction (anonymous-friendly, mobile-first, responses as first-class records)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node -e \"try { require.resolve('turbo') } catch (e) { console.error('\\n❌ Dependencies not installed. Run: pnpm install\\n'); process.exit(1); }\"",
    "build": "pnpm run build:stream",
    "build:stream": "turbo --log-order=stream build --filter=\"@mj-biz-apps/*\"",
    "build:generated": "turbo --log-order=stream build --filter=\"@mj-biz-apps/forms-entities\" --filter=\"@mj-biz-apps/forms-actions\"",
    "build:packages": "turbo --log-order=stream build --filter=\"@mj-biz-apps/forms-*\"",
    "test": "turbo --log-order=stream test",
    "test:packages": "turbo --log-order=stream test --filter=\"@mj-biz-apps/forms-*\"",
    "build:widget": "pnpm --filter @mj-biz-apps/forms-ng run build:widget",
    "mj:migrate": "mj migrate --schema __mj_BizAppsForms --dir ./migrations",
    "mj:codegen": "mj codegen",
    "mj:migrate:convert": "mj migrate convert --source-dir ./migrations --output-dir ./migrations-pg --schema __mj_BizAppsForms",
    "lint:ui": "node scripts/check-ui-tokens.mjs",
    "lint:generated": "node scripts/check-generated-schema-scope.mjs",
    "lint:distribution": "node scripts/check-distribution-seed.mjs",
    "lint:distribution:mutants": "node scripts/check-distribution-seed.mutants.mjs",
    "lint:codegen-compat": "node scripts/check-generated-api-compat.mjs",
    "lint:migrations": "node scripts/check-migration-order.mjs",
    "seed:manifest": "node scripts/write-seed-manifest.mjs",
    "smoke:respondent": "node smoke/respondent-path.mjs",
    "smoke:ownership": "node smoke/session-ownership-path.mjs",
    "smoke:scope": "node smoke/respondent-scope-path.mjs",
    "install:deps": "pnpm install",
    "setup": "echo 'Please run: pnpm run mj:migrate && pnpm run mj:codegen && pnpm run build'",
    "change": "changeset",
    "version": "changeset version",
    "commitpush": "node ci/commit_push.mjs",
    "mergemain": "node ci/merge_main.mjs",
    "mergemain:update-lock": "node ci/merge_main_and_update_lock.mjs",
    "smoke:binding": "node smoke/binding-path.mjs",
    "smoke:binding:seed": "node smoke/seed-binding-smoke.mjs",
    "smoke:automation": "node smoke/automation-semantics-path.mjs",
    "smoke:provenance": "node smoke/upload-provenance-path.mjs",
    "smoke:file-links": "node smoke/file-links-path.mjs",
    "smoke:resume-arc": "node smoke/resume-arc-path.mjs",
    "smoke:metadata": "node smoke/metadata-integrity-path.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-forms"
  },
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@memberjunction/cli": "6.1.0-edge.2",
    "beasties": "0.3.5",
    "mrmime": "2.0.1",
    "pg": "^8.22.0",
    "rolldown": "1.0.0-beta.58",
    "rollup": "^4.43.0",
    "simple-git": "^3.31.1",
    "tsc-alias": "^1.8.16",
    "turbo": "^2.7.3",
    "typescript": "^5.9.3",
    "@types/node": "^22.10.0",
    "zod": "^3.25.76",
    "@mj-biz-apps/forms-entities": "workspace:*"
  },
  "pnpm": {
    "overrides": {
      "@angular/animations": "21.1.3",
      "@angular/build": "21.1.3",
      "@angular/cli": "21.1.3",
      "@angular/common": "21.1.3",
      "@angular/compiler": "21.1.3",
      "@angular/compiler-cli": "21.1.3",
      "@angular/core": "21.1.3",
      "@angular/forms": "21.1.3",
      "@angular/localize": "21.1.3",
      "@angular/platform-browser": "21.1.3",
      "@angular/platform-browser-dynamic": "21.1.3",
      "@angular/router": "21.1.3",
      "@angular-devkit/build-angular": "21.1.3",
      "@memberjunction/core": "6.1.0-edge.2",
      "@memberjunction/global": "6.1.0-edge.2"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  }
}
