{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["build/**", "dist/**"],
      "cache": true,
      "dependsOn": ["^build"],
      "persistent": false
    },
    "test": {
      "outputs": [],
      "cache": true,
      "dependsOn": ["^build"],
      "persistent": false
    },
    "typecheck": {
      // Specs import sibling packages by their dist types, so this needs the same upstream builds
      // `test` does.
      "outputs": [],
      "cache": true,
      "dependsOn": ["^build"],
      "persistent": false
    },
    // TEMPORARY (#303 Task 9; Task 10 removes both entries with the import): the core-entities-server
    // suite and typecheck read forms-ng SOURCE — `src/reporting/__tests__/browser-parity.ts` holds
    // the server summary to the dashboard's own aggregation functions. That package does not depend
    // on forms-ng, so without these inputs an edit to those functions would replay a cached green
    // parity run (FULL TURBO) instead of re-running it.
    "@mj-biz-apps/forms-core-entities-server#test": {
      "outputs": [],
      "cache": true,
      "dependsOn": ["^build"],
      "persistent": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/Angular/src/lib/dashboard/services/*.ts",
        "$TURBO_ROOT$/packages/Angular/src/lib/dashboard/models/*.ts",
        "$TURBO_ROOT$/packages/Angular/src/lib/shared/*.ts",
        "$TURBO_ROOT$/packages/Angular/src/lib/responses/response-models.ts"
      ]
    },
    "@mj-biz-apps/forms-core-entities-server#typecheck": {
      "outputs": [],
      "cache": true,
      "dependsOn": ["^build"],
      "persistent": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/Angular/src/lib/dashboard/services/*.ts",
        "$TURBO_ROOT$/packages/Angular/src/lib/dashboard/models/*.ts",
        "$TURBO_ROOT$/packages/Angular/src/lib/shared/*.ts",
        "$TURBO_ROOT$/packages/Angular/src/lib/responses/response-models.ts"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true,
      // Turbo runs tasks in a FILTERED environment. Without this, every variable set in the shell
      // is dropped before the task sees it — only turbo's small built-in list (PATH, NODE_OPTIONS,
      // …) survives — so `FORMS_WIDGET_BUNDLE_PATH=… npm run start:api` booted MJAPI with the
      // variable absent, no warning and no error. That made the middleware's own remediation
      // advice ("or set FORMS_WIDGET_BUNDLE_PATH") impossible to follow through this repo's own
      // start script.
      //
      // `*` rather than an allow-list such as ["FORMS_*"]: an allow-list is incomplete by
      // construction. It fixes today's variables and silently drops the next one added, which is
      // the same defect again. Verified: with ["FORMS_*"] a probe variable outside the prefix
      // still arrived ABSENT; with ["*"] it arrived.
      //
      // Safe here ONLY because `start` is `cache: false`. passThroughEnv is deliberately excluded
      // from the cache hash, so putting `*` on a CACHED task would let an environment change
      // silently reuse a stale result. Do not copy this onto `build` or `test`.
      "passThroughEnv": ["*"]
    }
  }
}
