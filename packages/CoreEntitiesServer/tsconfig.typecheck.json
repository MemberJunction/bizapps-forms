{
  // Type-checks the SPECS. The base tsconfig excludes them so the build does not emit them, and
  // Vitest transpiles without checking — so until this existed nothing in the repo compiled a test
  // file, and seventy errors accumulated. Extends the real config and drops only the spec globs from
  // `exclude`; that omission IS the gate.
  "extends": "./tsconfig.json",
  // See `packages/Server/tsconfig.typecheck.json` for why this flag is in the no-emit gate
  // rather than in the build config: `emitDecoratorMetadata` output changes under it, and
  // type-graphql reads that at runtime.
  //
  // `rootDir` is widened for one test module: `reporting/__tests__/browser-parity.ts` (DW16
  // of #303) imports forms-ng's browser aggregation functions from their SOURCE, to hold the server
  // summary to them on one fixture. The build config keeps `src`; this gate emits nothing. Revert to
  // the inherited value once Task 10 turns that module into a golden snapshot.
  "compilerOptions": { "noEmit": true, "strictNullChecks": true, "rootDir": ".." },
  "exclude": ["node_modules", "dist"]
}
