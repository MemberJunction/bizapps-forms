{
  "name": "@mj-biz-apps/forms-core-entities-server",
  "type": "module",
  "version": "0.16.0",
  "description": "Server-side domain layer for MJ Forms — entity server subclasses (invariants that hold for every writer), the engines and Remote Operations, the on-submit automation outbox and its drain, and the shared helpers the actions and the server both run (response context, entity binding, provider resolution).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsc && tsc-alias -f",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "author": "MemberJunction.com",
  "license": "BUSL-1.1",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "axios": "1.19.0",
    "encoding": "0.1.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@mj-biz-apps/forms-entities": "0.16.0"
  },
  "peerDependencies": {
    "@memberjunction/actions": "^6.2.0-edge.8",
    "@memberjunction/actions-base": "^6.2.0-edge.8",
    "@memberjunction/ai-agents": "^6.2.0-edge.8",
    "@memberjunction/ai-core-plus": "^6.2.0-edge.8",
    "@memberjunction/core": "^6.2.0-edge.8",
    "@memberjunction/core-entities": "^6.2.0-edge.8",
    "@memberjunction/generic-database-provider": "^6.2.0-edge.8",
    "@memberjunction/global": "^6.2.0-edge.8",
    "@memberjunction/notifications": "^6.2.0-edge.8",
    "@memberjunction/redis-provider": "^6.2.0-edge.8",
    "@memberjunction/scheduling-base-types": "^6.2.0-edge.8",
    "@memberjunction/scheduling-engine": "^6.2.0-edge.8",
    "@memberjunction/sqlserver-dataprovider": "^6.2.0-edge.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-forms"
  }
}
