{
  "name": "@mj-biz-apps/forms-core-entities-server",
  "type": "module",
  "version": "0.15.1",
  "description": "Server-side domain layer for MJ Forms — entity server subclasses (invariants that hold for every writer), and the shared helpers the actions and the server both run (response context, entity binding, provider resolution).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "tsc && tsc-alias -f",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "author": "MemberJunction.com",
  "license": "BUSL-1.1",
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@mj-biz-apps/forms-entities": "0.15.1"
  },
  "peerDependencies": {
    "@memberjunction/core": "^6.2.0-edge.3",
    "@memberjunction/core-entities": "^6.2.0-edge.3",
    "@memberjunction/global": "^6.2.0-edge.3",
    "@memberjunction/sqlserver-dataprovider": "^6.2.0-edge.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MemberJunction/bizapps-forms"
  }
}
