    "fields": {
      "Name": "Forms: Generate Form From Brief",
      "Description": "AI form authoring — turns a natural-language brief (for example 'a 5-question event RSVP with dietary restrictions and a +1 count'), or a list of questions the author already wrote, into a draft Form with pages, questions, options, screens, conditional logic and a per-form style. With a SessionID the build runs in stages and publishes live progress; without one it is a single prompt. The model is metadata-driven in both cases — see the Forms AI Prompts.",
      "DriverClass": "Forms: Generate Form From Brief",
      "Type": "Custom",
      "CategoryID": "@lookup:MJ: Action Categories.Name=Forms",
      "Status": "Active",
