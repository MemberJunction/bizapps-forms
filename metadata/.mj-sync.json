{
  "version": "1.0.0",
  "push": {
    "autoCreateMissingRecords": true
  },
  "directoryOrder": [
    "schema-info",
    "roles",
    "action-categories",
    "ai-prompt-categories",
    "templates",
    "ai-prompts",
    "form-categories",
    "form-styles",
    "user-views",
    "applications",
    "dashboards",
    "query-categories",
    "queries",
    "application-roles",
    "entities",
    "entity-relationships",
    "entity-permissions",
    "actions",
    "api-scopes",
    "api-application-scopes",
    "remote-operation-categories",
    "remote-operations",
    "scheduled-job-types",
    "scheduled-jobs",
    "notification-types",
    "users",
    "user-roles"
  ],
  "emitSyncNotes": false,
  "sqlLogging": {
    "enabled": true,
    "outputDirectory": "./sql_logging",
    "formatAsMigration": true,
    "filterPatterns": [
      "*spCreateAIPromptRun*",
      "*spUpdateAIPromptRun*"
    ],
    "filterType": "exclude"
  }
}
